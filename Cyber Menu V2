	-- Joue les phases de chargement ; onPhase(idx) est appelé au début de chaque phase
	local function runPhases(phases, onPhase)
		for idx, ph in ipairs(phases) do
			loadPhase.Text = "> " .. ph.name .. "..."
			if onPhase then task.spawn(onPhase, idx) end
			local t0 = os.clock()
			while true do
				local a = math.clamp((os.clock() - t0) / ph.time, 0, 1)
				setProgress(ph.from + (ph.to - ph.from) * (a * a * (3 - 2 * a)))
				if math.random() < 0.12 then
					loadPhase.Text = "> " .. glitchString(#ph.name)
					task.wait(0.03)
					loadPhase.Text = "> " .. ph.name .. "..."
				end
				if a >= 1 then break end
				task.wait(0.04)
			end
		end
		setProgress(100)
	end

