	-- CRASHOUT : effet de zone sur tous les joueurs proches
	local function applyCrash(myRoot, victims)
		local camera = workspace.CurrentCamera
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		makeWave(myRoot.Position, cfg.CRASH_RADIUS, MAGENTA, 1.0)
		task.delay(0.25, function() makeWave(myRoot.Position, cfg.CRASH_RADIUS, RED, 1.0) end)

		local cc = Instance.new("ColorCorrectionEffect")
		cc.TintColor = Color3.fromRGB(255, 80, 120)
		cc.Contrast = 0.35
		cc.Saturation = 0.4
		cc.Parent = Lighting
		local blur = Instance.new("BlurEffect")
		blur.Size = 10
		blur.Parent = Lighting

		vignette.Visible = true
		local objs = {}
		local fx = {}
		for _, v in ipairs(victims) do
			local char = v.plr.Character
			local head = char and char:FindFirstChild("Head")
			if char and head then
				local hl = Instance.new("Highlight")
				hl.FillColor = RED
				hl.FillTransparency = 0.4
				hl.OutlineColor = Color3.new(1, 1, 1)
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.Adornee = char
				hl.Parent = char
				table.insert(objs, hl)

				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromOffset(220, 50)
				bb.StudsOffset = Vector3.new(0, 3.2, 0)
				bb.AlwaysOnTop = true
				bb.Adornee = head
				bb.Parent = head
				table.insert(objs, bb)

				local l1 = Instance.new("TextLabel")
				l1.Size = UDim2.new(1, 0, 0.55, 0)
				l1.BackgroundTransparency = 1
				l1.Font = Enum.Font.Code
				l1.TextSize = 16
				l1.TextColor3 = RED
				l1.TextStrokeTransparency = 0.2
				l1.Parent = bb
				local l2 = Instance.new("TextLabel")
				l2.Size = UDim2.new(1, 0, 0.45, 0)
				l2.Position = UDim2.fromScale(0, 0.55)
				l2.BackgroundTransparency = 1
				l2.Font = Enum.Font.Code
				l2.TextSize = 13
				l2.TextColor3 = Color3.fromRGB(255, 200, 210)
				l2.TextStrokeTransparency = 0.4
				l2.Text = v.plr.Name
				l2.Parent = bb

				local pe = Instance.new("ParticleEmitter")
				pe.Rate = 40
				pe.Lifetime = NumberRange.new(0.5, 1)
				pe.Speed = NumberRange.new(4, 8)
				pe.SpreadAngle = Vector2.new(180, 180)
				pe.LightEmission = 1
				pe.Color = ColorSequence.new(RED)
				pe.Size = NumberSequence.new(0.4, 0)
				pe.Parent = head
				table.insert(objs, pe)

				table.insert(fx, { hl = hl, l1 = l1 })
			end
		end

		local t0 = os.clock()
		while os.clock() - t0 < cfg.CRASH_DURATION do
			local alt = math.random() < 0.5
			for _, f in ipairs(fx) do
				if f.hl.Parent then
					f.hl.FillColor = alt and RED or Color3.new(1, 1, 1)
					f.hl.FillTransparency = 0.2 + 0.5 * math.random()
					f.l1.Text = (math.random() < 0.3) and glitchString(10) or "⚠ CRASHOUT ⚠"
				end
			end
			for _, e in ipairs(vEdges) do e.BackgroundTransparency = math.random() * 0.5 end
			cc.TintColor = alt and Color3.fromRGB(255, 60, 100) or Color3.fromRGB(255, 200, 220)
			blur.Size = 3 + math.random() * 9
			if humanoid and humanoid.Parent then
				humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.5, 0)
			end
			task.wait(0.07)
		end

		if humanoid and humanoid.Parent then humanoid.CameraOffset = Vector3.new(0, 0, 0) end
		for _, o in ipairs(objs) do
			if o and o.Parent then o:Destroy() end
		end
		vignette.Visible = false
		TweenService:Create(cc, TweenInfo.new(0.5), {TintColor = Color3.new(1, 1, 1), Contrast = 0, Saturation = 0}):Play()
		TweenService:Create(blur, TweenInfo.new(0.5), {Size = 0}):Play()
		Debris:AddItem(cc, 0.7)
		Debris:AddItem(blur, 0.7)
	end

	local function runCrashout()
		if busy then return end
		local character = player.Character
		local myRoot = character and character:FindFirstChild("HumanoidRootPart")
		if not myRoot then setStatus("Perso introuvable") return end

		local victims = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				local root = plr.Character:FindFirstChild("HumanoidRootPart")
				if root and (root.Position - myRoot.Position).Magnitude <= cfg.CRASH_RADIUS then
					table.insert(victims, { plr = plr })
				end
			end
		end
		if #victims == 0 then setStatus("Crashout : personne dans la zone") return end

		busy = true
		crashBtn.Text = "[ CRASHOUT EN COURS... ]"
		crashBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
		setStatus("Crashout en cours...")
		loadTitle.Text = ("CRASHOUT : %d cible(s) dans %dm"):format(#victims, cfg.CRASH_RADIUS)
		loadTitle.TextColor3 = MAGENTA
		setProgress(0)
		loader.Visible = true
		task.spawn(screenFlash, false)

		local function rp(i)
			if rpEnabled then
				local s = CRASH_RP[i]:gsub("{n}", tostring(#victims)):gsub("{r}", tostring(cfg.CRASH_RADIUS))
				chatSay(s)
			end
		end

		runPhases(CRASH_PHASES, function(idx)
			if idx == 1 then rp(1) elseif idx == 3 then rp(2) end
		end)

		loadPhase.Text = "> CERVEAUX EN SURCHARGE"
		loadPhase.TextColor3 = RED
		task.spawn(rp, 3)
		task.wait(0.3)
		loader.Visible = false
		loadPhase.TextColor3 = YELLOW
		loadTitle.TextColor3 = GREEN

		applyCrash(myRoot, victims)

		setStatus("Crashout : " .. #victims .. " cerveau(x) grillé(s) ✔")
		crashBtn.Text = "[ CRASHOUT : ZONE ]"
		crashBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 90)
		busy = false
	end
	table.insert(connections, crashBtn.MouseButton1Click:Connect(function() task.spawn(runCrashout) end))

