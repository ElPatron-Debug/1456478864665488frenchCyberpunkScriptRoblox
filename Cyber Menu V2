	local function spawnGhost(character, t)
		local root = character:FindFirstChild("HumanoidRootPart")
		local rootY = root and root.Position.Y or 0
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
				local ok2, ghost = pcall(function() return part:Clone() end)
				if ok2 and ghost then
					ghost:ClearAllChildren()
					ghost.Anchored = true
					ghost.CanCollide = false
					ghost.CanQuery = false
					ghost.CanTouch = false
					ghost.Massless = true
					ghost.Material = Enum.Material.Neon
					ghost.Color = getColor(t, ((part.Position.Y - rootY) * 0.08) % 1)
					ghost.Transparency = 0.35
					ghost.CFrame = part.CFrame
					ghost.Parent = workspace
					TweenService:Create(ghost, TweenInfo.new(0.45), {Transparency = 1}):Play()
					Debris:AddItem(ghost, 0.55)
				end
			end
		end
	end

	local function startSandevistan()
		if active or onCooldown then return end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local camera = workspace.CurrentCamera
		if not humanoid or not camera then setStatus("Perso introuvable") return end

		active = true
		setStatus("SANDEVISTAN ACTIF !")

		local cc = Instance.new("ColorCorrectionEffect")
		cc.Parent = Lighting
		TweenService:Create(cc, TweenInfo.new(0.4), {Saturation = 0.3, Contrast = 0.2}):Play()
		local blur = Instance.new("BlurEffect")
		blur.Size = 0
		blur.Parent = Lighting
		TweenService:Create(blur, TweenInfo.new(0.4), {Size = 6}):Play()

		local baseFov = camera.FieldOfView
		TweenService:Create(camera, TweenInfo.new(0.4), {FieldOfView = baseFov + 20}):Play()
		local baseSpeed = humanoid.WalkSpeed
		humanoid.WalkSpeed = baseSpeed * cfg.SPEED_MULT

		local startTime = os.clock()
		while os.clock() - startTime < cfg.DURATION and active do
			if not character.Parent or humanoid.Health <= 0 then break end
			local t = os.clock() - startTime
			spawnGhost(character, t)
			if cfg.SCREEN_TINT then
				cc.TintColor = Color3.new(1, 1, 1):Lerp(getColor(t, 0), 0.35)
			end
			task.wait(cfg.GHOST_RATE)
		end

		if humanoid and humanoid.Parent then humanoid.WalkSpeed = baseSpeed end
		TweenService:Create(camera, TweenInfo.new(0.4), {FieldOfView = baseFov}):Play()
		TweenService:Create(blur, TweenInfo.new(0.4), {Size = 0}):Play()
		TweenService:Create(cc, TweenInfo.new(0.4), {
			Saturation = 0, TintColor = Color3.new(1, 1, 1), Contrast = 0,
		}):Play()
		Debris:AddItem(blur, 0.5)
		Debris:AddItem(cc, 0.5)

		active = false
		onCooldown = true
		for i = cfg.COOLDOWN, 1, -1 do
			if not gui.Parent then return end
			setStatus("Sandevistan recharge : " .. i .. "s")
			task.wait(1)
		end
		onCooldown = false
		setStatus("Prêt")
	end

	-- SCAN : onde + contour rouge pulsant (le corps reste visible)
	local function startScan()
		if scanning or scanOnCooldown then return end
		local character = player.Character
		local myRoot = character and character:FindFirstChild("HumanoidRootPart")
		if not myRoot then setStatus("Perso introuvable") return end

		scanning = true
		local WAVE_TIME = 1.2
		makeWave(myRoot.Position, cfg.SCAN_RADIUS, Color3.fromRGB(255, 30, 50), WAVE_TIME)

		local marks = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				local root = plr.Character:FindFirstChild("HumanoidRootPart")
				local head = plr.Character:FindFirstChild("Head")
				local dist = root and (root.Position - myRoot.Position).Magnitude
				if root and head and dist <= cfg.SCAN_RADIUS then
					local hl = Instance.new("Highlight")
					hl.FillColor = Color3.fromRGB(255, 0, 30)
					hl.FillTransparency = 0.88
					hl.OutlineColor = Color3.fromRGB(255, 40, 60)
					hl.OutlineTransparency = 0
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Adornee = plr.Character
					hl.Enabled = false
					hl.Parent = plr.Character
					table.insert(scanObjects, hl)

					local bb = Instance.new("BillboardGui")
					bb.Size = UDim2.fromOffset(200, 48)
					bb.StudsOffset = Vector3.new(0, 3.2, 0)
					bb.AlwaysOnTop = true
					bb.Enabled = false
					bb.Adornee = head
					bb.Parent = head
					table.insert(scanObjects, bb)

					local nameL = Instance.new("TextLabel")
					nameL.Size = UDim2.new(1, 0, 0.55, 0)
					nameL.BackgroundTransparency = 1
					nameL.TextColor3 = Color3.fromRGB(255, 50, 70)
					nameL.TextStrokeTransparency = 0.3
					nameL.Font = Enum.Font.Code
					nameL.TextSize = 16
					nameL.Text = "[ " .. plr.Name .. " ]"
					nameL.Parent = bb

					local distL = Instance.new("TextLabel")
					distL.Size = UDim2.new(1, 0, 0.45, 0)
					distL.Position = UDim2.fromScale(0, 0.55)
					distL.BackgroundTransparency = 1
					distL.TextColor3 = Color3.fromRGB(255, 160, 170)
					distL.TextStrokeTransparency = 0.5
					distL.Font = Enum.Font.Code
					distL.TextSize = 13
					distL.Text = ""
					distL.Parent = bb

					table.insert(marks, {
						plr = plr, root = root, hl = hl, bb = bb, nameL = nameL, distL = distL,
						appearAt = (dist / cfg.SCAN_RADIUS) * WAVE_TIME, shown = false,
					})
				end
			end
		end

		setStatus((#marks == 0) and "Scan : personne à proximité" or ("SCAN : " .. #marks .. " cible(s)"))

		-- cadre rouge + ligne de scan
		vignette.Visible = true
		scanLine.Visible = true
		task.spawn(function()
			while scanning and gui.Parent do
				scanLine.Position = UDim2.new(0, 0, 0, 0)
				TweenService:Create(scanLine, TweenInfo.new(1.2, Enum.EasingStyle.Linear), {
					Position = UDim2.new(0, 0, 1, 0),
				}):Play()
				task.wait(1.2)
			end
		end)

		local startTime = os.clock()
		while os.clock() - startTime < cfg.SCAN_DURATION and scanning do
			local t = os.clock() - startTime
			local pulse = 0.5 + 0.5 * math.sin(t * 6)

			for _, f in ipairs(vEdges) do
				f.BackgroundTransparency = 0.15 + 0.35 * (1 - pulse)
			end

			for _, m in ipairs(marks) do
				if t >= m.appearAt then
					if not m.shown then
						m.shown = true
						m.hl.Enabled = true
						m.bb.Enabled = true
					end
					m.hl.FillTransparency = 0.8 + 0.15 * pulse
					m.hl.OutlineColor = Color3.fromRGB(255, 40, 60):Lerp(Color3.fromRGB(255, 190, 190), pulse * 0.5)
					if m.root and m.root.Parent and myRoot.Parent then
						local d = math.floor((m.root.Position - myRoot.Position).Magnitude)
						m.distL.Text = d .. "m"
					end
				end
			end
			task.wait(0.05)
		end

		clearScan()
		vignette.Visible = false
		scanLine.Visible = false
		scanning = false
		scanOnCooldown = true
		task.wait(cfg.SCAN_COOLDOWN)
		scanOnCooldown = false
		if not active and not onCooldown then setStatus("Prêt") end
	end

