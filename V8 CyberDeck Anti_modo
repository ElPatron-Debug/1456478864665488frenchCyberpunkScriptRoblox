	-- RAGDOLL
	local function unragdoll()
		local s = st.rag
		if not s then return end
		st.rag = nil
		for _, o in ipairs(s.created) do
			if o and o.Parent then pcall(function() o:Destroy() end) end
		end
		for _, m in ipairs(s.motors) do
			pcall(function() if m[1] and m[1].Parent then m[1].Enabled = m[2] end end)
		end
		for _, p in ipairs(s.parts) do
			pcall(function() if p[1] and p[1].Parent then p[1].CanCollide = p[2] end end)
		end
		pcall(function()
			if s.hum and s.hum.Parent and s.hum.Health > 0 then
				s.hum.PlatformStand = false
				s.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end
	local function ragdoll(duration)
		if st.rag then return end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not (hum and root) or hum.Health <= 0 then return end

		local s = { hum = hum, motors = {}, created = {}, parts = {} }
		st.rag = s
		for _, m in ipairs(char:GetDescendants()) do
			if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Part0 ~= root and m.Part1 ~= root then
				local a0 = new("Attachment", { CFrame = m.C0 }, m.Part0)
				local a1 = new("Attachment", { CFrame = m.C1 }, m.Part1)
				local bs = new("BallSocketConstraint", {
					Attachment0 = a0, Attachment1 = a1, LimitsEnabled = true, UpperAngle = 70,
					TwistLimitsEnabled = true, TwistLowerAngle = -40, TwistUpperAngle = 40,
				}, m.Part0)
				table.insert(s.created, a0)
				table.insert(s.created, a1)
				table.insert(s.created, bs)
				table.insert(s.motors, { m, m.Enabled })
				m.Enabled = false
				table.insert(s.parts, { m.Part1, m.Part1.CanCollide })
				m.Part1.CanCollide = true
			end
		end
		hum.PlatformStand = true
		hum:ChangeState(Enum.HumanoidStateType.Physics)
		root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new((math.random() - 0.5) * 30, 25, (math.random() - 0.5) * 30)
		root.AssemblyAngularVelocity = Vector3.new((math.random() - 0.5) * 10, (math.random() - 0.5) * 10, (math.random() - 0.5) * 10)

		task.delay(duration, function() if st.rag == s then unragdoll() end end)
		task.spawn(function()
			while st.rag == s do
				if not char.Parent or hum.Health <= 0 then unragdoll() break end
				task.wait(0.2)
			end
		end)
	end
	fn.ragdoll = ragdoll

