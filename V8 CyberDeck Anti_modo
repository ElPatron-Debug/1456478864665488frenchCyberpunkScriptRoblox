	safe("Réception", function()
		local receiving = false
		local function glitchHit(sender)
			toast("⚠ INTRUSION DÉTECTÉE : " .. sender.Name, C.GREEN, 3)
			local cc = newFx("ColorCorrectionEffect", { TintColor = Color3.fromRGB(120, 255, 170), Contrast = 0.3 })
			local blur = newFx("BlurEffect", { Size = 8 })
			TweenService:Create(cc, TweenInfo.new(0.7), { TintColor = C.WHITE, Contrast = 0 }):Play()
			TweenService:Create(blur, TweenInfo.new(0.7), { Size = 0 }):Play()
			Debris:AddItem(cc, 1)
			Debris:AddItem(blur, 1)
		end
		local function crashHit(sender)
			if receiving then return end
			receiving = true
			toast("⚠ CRASHOUT : surcharge neuronale (" .. sender.Name .. ")", C.RED, 5)
			if cfg.RAGDOLL then
				local ok4, e4 = pcall(ragdoll, cfg.RAGDOLL_TIME)
				if not ok4 then warn("[CyberDeck] ragdoll : " .. tostring(e4)) end
			end
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			local cc = newFx("ColorCorrectionEffect", { TintColor = Color3.fromRGB(255, 80, 120), Contrast = 0.35, Saturation = 0.4 })
			local blur = newFx("BlurEffect", { Size = 10 })
			vignette.Visible = true
			pcall(function()
				local t0 = os.clock()
				while os.clock() - t0 < cfg.CRASH_DURATION and gui.Parent do
					local alt = math.random() < 0.5
					cc.TintColor = alt and Color3.fromRGB(255, 60, 100) or Color3.fromRGB(255, 200, 220)
					blur.Size = 3 + math.random() * 9
					for _, e in ipairs(vEdges) do e.BackgroundTransparency = math.random() * 0.5 end
					if hum and hum.Parent then
						hum.CameraOffset = Vector3.new((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.5, 0)
					end
					task.wait(0.07)
				end
			end)
			if hum and hum.Parent then hum.CameraOffset = Vector3.new(0, 0, 0) end
			if not st.scanning then vignette.Visible = false end
			TweenService:Create(cc, TweenInfo.new(0.5), { TintColor = C.WHITE, Contrast = 0, Saturation = 0 }):Play()
			TweenService:Create(blur, TweenInfo.new(0.5), { Size = 0 }):Play()
			Debris:AddItem(cc, 0.7)
			Debris:AddItem(blur, 0.7)
			receiving = false
		end

		local function hasAny(s, list)
			for _, w in ipairs(list) do
				if s:find(w, 1, true) then return true end
			end
			return false
		end
		local lastReply = 0
		local function onMessage(sender, text)
			if not sender or sender == player or type(text) ~= "string" then return end
			local low = text:lower()

			if low:find(D.PING, 1, true) then
				markCyber(sender)
				if cfg.REPLY_TO_SCAN and os.clock() - lastReply > 8 then
					local dd = distanceTo(sender)
					if not dd or dd <= cfg.PING_RADIUS then
						lastReply = os.clock()
						task.delay(0.5 + math.random() * 1.5, function() chatSay(D.REPLY) end)
					end
				end
				return
			end
			if low:find(D.REPLY, 1, true) then markCyber(sender) return end
			if low:sub(1, 1) ~= "*" then return end

			local isCrash, isHack = hasAny(low, D.CRASH_WORDS), hasAny(low, D.HACK_WORDS)
			if not (isCrash or isHack) then return end
			markCyber(sender)

			local targeted = low:find(player.Name:lower(), 1, true) or low:find(player.DisplayName:lower(), 1, true)
			if not targeted and isCrash then
				local r = tonumber(low:match("rayon de (%d+)m"))
				local dd = r and distanceTo(sender)
				if r and dd and dd <= r then targeted = true end
			end
			if not targeted or not cfg.RECEIVE_EFFECTS then return end
			if isCrash then task.spawn(crashHit, sender) else task.spawn(glitchHit, sender) end
		end

		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			table.insert(conns, TextChatService.MessageReceived:Connect(function(msg)
				local src = msg.TextSource
				if src then onMessage(Players:GetPlayerByUserId(src.UserId), msg.Text) end
			end))
		else
			local function watch(p) table.insert(conns, p.Chatted:Connect(function(m) onMessage(p, m) end)) end
			for _, p in ipairs(Players:GetPlayers()) do watch(p) end
			table.insert(conns, Players.PlayerAdded:Connect(watch))
		end
	end)

