	local function new(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props or {}) do o[k] = v end
		if parent then o.Parent = parent end
		return o
	end
	local function stroke(parent, color, thick, transp)
		return new("UIStroke", {
			Color = color, Thickness = thick or 1, Transparency = transp or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, parent)
	end
	local function label(parent, text, x, y, w, h, color, size, font, align)
		return new("TextLabel", {
			BackgroundTransparency = 1, Text = text, Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h), TextColor3 = color or C.WHITE, TextSize = size or 13,
			Font = font or Enum.Font.Code, TextXAlignment = align or Enum.TextXAlignment.Left,
		}, parent)
	end
	local function icon(parent, ic, x, y, w, h, color, size)
		if type(ic) == "string" and ic:find("rbxassetid") then
			return new("ImageLabel", {
				BackgroundTransparency = 1, Image = ic, ImageColor3 = color,
				Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
			}, parent)
		end
		return new("TextLabel", {
			BackgroundTransparency = 1, Text = ic, TextColor3 = color, TextSize = size or 20,
			Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		}, parent)
	end
	local function setIconColor(obj, color)
		if obj:IsA("ImageLabel") then obj.ImageColor3 = color else obj.TextColor3 = color end
	end
	local function button(parent, text, x, y, w, h, color)
		color = color or C.CYAN
		local b = new("TextButton", {
			Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = C.PANEL2,
			BorderSizePixel = 0, Text = text, TextColor3 = C.WHITE, Font = Enum.Font.Code, TextSize = 13,
			AutoButtonColor = false,
		}, parent)
		local s = stroke(b, color, 1, 0.55)
		table.insert(conns, b.MouseEnter:Connect(function() s.Transparency = 0 end))
		table.insert(conns, b.MouseLeave:Connect(function() s.Transparency = 0.55 end))
		return b
	end
	local function setSel(b, on, color)
		b.BackgroundColor3 = on and C.PANEL2:Lerp(color, 0.45) or C.PANEL2
	end
	local function section(parent, text, x, y, w, color)
