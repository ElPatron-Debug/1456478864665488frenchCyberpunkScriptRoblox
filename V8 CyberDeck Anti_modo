	safe("Aimlock", function()
		local aimTarget, aimRot, lastPick = nil, nil, 0
		local function aimPart(plr)
			local char = plr.Character
			return char and char:FindFirstChild(cfg.AIM_HEAD and "Head" or "HumanoidRootPart")
		end
		local function isVisible(cam, part)
			if not cfg.AIM_WALLCHECK then return true end
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { player.Character }
			local res = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params)
			return (not res) or res.Instance:IsDescendantOf(part.Parent)
		end
		local function validAim(cam, plr)
			local part = aimPart(plr)
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if not part or not hum or hum.Health <= 0 then return nil end
			if (part.Position - cam.CFrame.Position).Magnitude > cfg.AIM_RANGE then return nil end
			if not isVisible(cam, part) then return nil end
			return part
		end
		local function pickAim(cam)
			local best, bestAng
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player then
					local part = validAim(cam, plr)
					if part then
						local dir = (part.Position - cam.CFrame.Position).Unit
						local ang = math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir), -1, 1)))
						if ang <= cfg.AIM_FOV and (not best or ang < bestAng) then best, bestAng = plr, ang end
					end
				end
			end
			return best
		end

		pcall(function() RunService:UnbindFromRenderStep("CyberDeckAim") end)
		RunService:BindToRenderStep("CyberDeckAim", Enum.RenderPriority.Camera.Value + 1, function(dt)
			local ok3 = pcall(function()
				local cam = workspace.CurrentCamera
				local char = player.Character
				local tool = char and char:FindFirstChildOfClass("Tool")
				if not (cfg.AIMLOCK and st.active and tool and cam) or st.rag then
					aimTarget, aimRot = nil, nil
					lockLbl.Visible = false
					return
				end
				if aimTarget and not validAim(cam, aimTarget) then aimTarget, aimRot = nil, nil end
				if not aimTarget and os.clock() - lastPick > 0.1 then
					lastPick = os.clock()
					aimTarget = pickAim(cam)
				end
				local part = aimTarget and aimPart(aimTarget)
				if not part then lockLbl.Visible = false return end
				local pos = cam.CFrame.Position
				local goalRot = CFrame.lookAt(pos, part.Position).Rotation
				local a = math.clamp(dt * cfg.AIM_SPEED, 0, 1)
				aimRot = aimRot and aimRot:Lerp(goalRot, a) or cam.CFrame.Rotation
				cam.CFrame = CFrame.new(pos) * aimRot
				lockLbl.Visible = true
				lockLbl.Text = ("🎯 LOCK : %s  [%dm]"):format(aimTarget.Name, math.floor((part.Position - pos).Magnitude))
			end)
			if not ok3 then aimTarget, aimRot = nil, nil end
		end)
		table.insert(conns, { Disconnect = function() pcall(function() RunService:UnbindFromRenderStep("CyberDeckAim") end) end })
	end)

