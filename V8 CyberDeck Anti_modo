			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not myRoot then setStatus("Perso introuvable", C.RED) return end

			st.scanning = true
			if cfg.SEND_PING then task.spawn(chatSay, D.PING) end
			local WAVE = 1.2
			makeWave(myRoot.Position, cfg.SCAN_RADIUS, Color3.fromRGB(255, 30, 50), WAVE)

			local marks = {}
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character then
					local root = plr.Character:FindFirstChild("HumanoidRootPart")
					local head = plr.Character:FindFirstChild("Head")
					local dist = root and (root.Position - myRoot.Position).Magnitude
					if root and head and dist <= cfg.SCAN_RADIUS then
						local hl = new("Highlight", {
							FillColor = Color3.fromRGB(255, 0, 30), FillTransparency = 0.88, OutlineColor = C.RED,
							DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = plr.Character, Enabled = false,
						}, plr.Character)
						table.insert(scanObjects, hl)
						local bb = new("BillboardGui", {
							Size = UDim2.fromOffset(220, 66), StudsOffset = Vector3.new(0, 3.6, 0), AlwaysOnTop = true,
							Enabled = false, Adornee = head,
						}, head)
						table.insert(scanObjects, bb)
						billLabel(bb, 0, 0.34, 16, Color3.fromRGB(255, 50, 70), "[ " .. plr.Name .. " ]")
						table.insert(marks, {
							plr = plr, root = root, hl = hl, bb = bb,
							distL = billLabel(bb, 0.34, 0.3, 13, Color3.fromRGB(255, 160, 170), ""),
							cyberL = billLabel(bb, 0.64, 0.36, 14, C.CYAN, ""),
							appearAt = (dist / cfg.SCAN_RADIUS) * WAVE, shown = false,
						})
					end
				end
			end
			setStatus((#marks == 0) and "Scan : personne à proximité" or ("SCAN : " .. #marks .. " cible(s)"), C.RED)

			vignette.Visible, scanLine.Visible = true, true
			task.spawn(function()
				while st.scanning and gui.Parent do
					scanLine.Position = UDim2.new(0, 0, 0, 0)
					TweenService:Create(scanLine, TweenInfo.new(1.2, Enum.EasingStyle.Linear), { Position = UDim2.new(0, 0, 1, 0) }):Play()
					task.wait(1.2)
				end
			end)

			local start = os.clock()
			while os.clock() - start < cfg.SCAN_DURATION and st.scanning do
				local t = os.clock() - start
				local pulse = 0.5 + 0.5 * math.sin(t * 6)
				for _, f in ipairs(vEdges) do f.BackgroundTransparency = 0.15 + 0.35 * (1 - pulse) end
				local cyberCount = 0
				for _, m in ipairs(marks) do
					if t >= m.appearAt then
						if not m.shown then m.shown, m.hl.Enabled, m.bb.Enabled = true, true, true end
						if cyber[m.plr] then
							cyberCount += 1
							m.hl.FillColor = Color3.fromRGB(0, 200, 255)
							m.hl.FillTransparency = 0.75 + 0.15 * pulse
							m.hl.OutlineColor = C.CYAN:Lerp(C.MAG, pulse)
							m.cyberL.Text = "⚡ CYBERWARE DÉTECTÉ"
							m.cyberL.TextColor3 = C.CYAN:Lerp(C.MAG, pulse)
						else
							m.hl.FillColor = Color3.fromRGB(255, 0, 30)
							m.hl.FillTransparency = 0.8 + 0.15 * pulse
							m.hl.OutlineColor = C.RED:Lerp(Color3.fromRGB(255, 190, 190), pulse * 0.5)
							m.cyberL.Text = "aucun implant"
							m.cyberL.TextColor3 = Color3.fromRGB(150, 110, 115)
						end
						if m.root.Parent and myRoot.Parent then
							m.distL.Text = math.floor((m.root.Position - myRoot.Position).Magnitude) .. "m"
						end
					end
				end
				if #marks > 0 then setStatus(("SCAN : %d cible(s), %d cyberware"):format(#marks, cyberCount), C.RED) end
				task.wait(0.05)
			end

			clearScan()
			vignette.Visible, scanLine.Visible, st.scanning = false, false, false
			st.scanOnCooldown = true
			task.wait(cfg.SCAN_COOLDOWN)
			st.scanOnCooldown = false
			if not st.active and not st.onCooldown then setStatus("Système prêt") end
		end)
		table.insert(conns, scanBtn.MouseButton1Click:Connect(function() task.spawn(fn.startScan) end))
	end)

