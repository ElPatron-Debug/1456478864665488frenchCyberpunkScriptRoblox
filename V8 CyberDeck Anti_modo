	safe("Détection", function()
		local function stopSand(plr)
			local s = det[plr]
			if not s then return end
			if s.bb then s.bb:Destroy() end
			if s.hl then s.hl:Destroy() end
			s.on, s.bb, s.lbl, s.hl, s.hits = false, nil, nil, nil, 0
		end
		fn.stopSand = stopSand
		local function startSand(plr, head)
			local s = det[plr]
			local bb = new("BillboardGui", {
				Size = UDim2.fromOffset(220, 26), StudsOffset = Vector3.new(0, 4.4, 0), AlwaysOnTop = true, Adornee = head,
			}, head)
			local lbl = new("TextLabel", {
				Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 16,
				TextStrokeTransparency = 0.3,
			}, bb)
			local hl = new("Highlight", {
				FillTransparency = 1, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = plr.Character,
			}, plr.Character)
			s.on, s.bb, s.lbl, s.hl = true, bb, lbl, hl
			markCyber(plr)
			toast("⚡ SANDEVISTAN DÉTECTÉ : " .. plr.Name, C.CYAN, 4)
		end
		local acc = 0
		table.insert(conns, RunService.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.1 then return end
			acc = 0
			if not cfg.DETECT_SANDE then
				for _, p in ipairs(Players:GetPlayers()) do stopSand(p) end
				return
			end
			local needed = math.max(1, math.floor(cfg.HOLD_TIME / 0.1))
			local hue = (os.clock() * 0.6) % 1
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player then
					det[plr] = det[plr] or { hits = 0, last = 0, on = false, speed = 0 }
					local s = det[plr]
					local char = plr.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local head = char and char:FindFirstChild("Head")
					if s.on and (not s.bb or not s.bb.Parent) then stopSand(plr) end
					if root and hum and head then
						local dd = distanceTo(plr)
						local v = root.AssemblyLinearVelocity
						local speed = Vector3.new(v.X, 0, v.Z).Magnitude
						local fast = speed >= cfg.SPEED_THRESHOLD and hum.SeatPart == nil and hum.Health > 0
							and (not dd or dd <= cfg.DETECT_RADIUS)
						if fast then
							s.hits += 1
							s.last, s.speed = os.clock(), speed
							if s.hits >= needed and not s.on then startSand(plr, head) end
							if s.on then
								local c = Color3.fromHSV(hue, 0.9, 1)
								s.lbl.Text = ("⚡ SANDEVISTAN  %d"):format(math.floor(speed))
								s.lbl.TextColor3, s.hl.OutlineColor = c, c
							end
						else
							s.hits = 0
							if s.on and os.clock() - s.last > 1.5 then stopSand(plr) end
						end
					elseif s.on then
						stopSand(plr)
					end
				end
			end
		end))
		table.insert(conns, Players.PlayerRemoving:Connect(function(p) stopSand(p) det[p] = nil end))
	end)

