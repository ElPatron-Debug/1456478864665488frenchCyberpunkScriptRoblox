		if ui.crashBtn then ui.crashBtn.Text = "☠ CRASHOUT" ui.crashBtn.BackgroundColor3 = C.PANEL2 end
	end
	local function guard(name, f)
		return function(...)
			local args = table.pack(...)
			local ok2, e = pcall(function() f(table.unpack(args, 1, args.n)) end)
			if not ok2 then
				warn("[CyberDeck] erreur dans " .. name .. " : " .. tostring(e))
				resetAll()
				setStatus(("Erreur %s : %s"):format(name, tostring(e):sub(1, 70)), C.RED)
			end
		end
	end
	local function safe(name, f)
		local ok2, e = pcall(f)
		if not ok2 then
			warn("[CyberDeck] chargement de " .. name .. " : " .. tostring(e))
			setStatus(("Erreur chargement %s : %s"):format(name, tostring(e):sub(1, 60)), C.RED)
		end
	end

