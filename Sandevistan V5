	Instance.new("UICorner", c).CornerRadius = UDim.new(0, 6)
end

local function addNumber(label, key, minV, maxV)
	local row = makeRow(label)
	local box = Instance.new("TextBox")
	box.Text = tostring(cfg[key])
	box.ClearTextOnFocus = false
	styleControl(box, row)
	table.insert(connections, box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then cfg[key] = math.clamp(n, minV, maxV) end
		box.Text = tostring(cfg[key])
	end))
end

local function addKeybind(label, key)
	local row = makeRow(label)
	local btn = Instance.new("TextButton")
	btn.Text = keys[key].Name
	styleControl(btn, row)
	table.insert(connections, btn.MouseButton1Click:Connect(function()
		waitingFor, waitingButton = key, btn
		btn.Text = "Appuie..."
	end))
end

local function addToggle(label, getText, onClick)
	local row = makeRow(label)
	local btn = Instance.new("TextButton")
	btn.Text = getText()
	styleControl(btn, row)
	table.insert(connections, btn.MouseButton1Click:Connect(function()
		onClick()
		btn.Text = getText()
	end))
end

