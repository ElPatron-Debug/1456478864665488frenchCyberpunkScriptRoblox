----------------------------------------------------------------
-- COULEURS
----------------------------------------------------------------
local function getColor(t, offset)
	if cfg.COLOR_MODE == "palette" then
		local i = (math.floor(t * cfg.COLOR_SPEED * 3 + offset * #PALETTE) % #PALETTE) + 1
		return PALETTE[i]
	end
	return Color3.fromHSV((t * cfg.COLOR_SPEED * 0.5 + offset) % 1, 0.9, 1)
end

----------------------------------------------------------------
-- EFFET SANDEVISTAN
----------------------------------------------------------------
local function spawnGhost(character, t)
	local root = character:FindFirstChild("HumanoidRootPart")
	local rootY = root and root.Position.Y or 0

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			local ok, ghost = pcall(function() return part:Clone() end)
			if ok and ghost then
				ghost:ClearAllChildren()
				ghost.Anchored = true
				ghost.CanCollide = false
				ghost.CanQuery = false
				ghost.CanTouch = false
				ghost.Massless = true
				ghost.Material = Enum.Material.Neon
				local offset = ((part.Position.Y - rootY) * 0.08) % 1
				ghost.Color = getColor(t, offset)
				ghost.Transparency = 0.35
				ghost.CFrame = part.CFrame
				ghost.Parent = workspace
				TweenService:Create(ghost, TweenInfo.new(0.45), {Transparency = 1}):Play()
				Debris:AddItem(ghost, 0.55)
			end
		end
	end
end

local function startSandevistan()
	if active or onCooldown then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera
	if not humanoid or not camera then return end

	active = true
	status.Text = "SANDEVISTAN ACTIF !"

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Parent = Lighting
	TweenService:Create(cc, TweenInfo.new(0.4), {Saturation = 0.3, Contrast = 0.2}):Play()

	local blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = Lighting
	TweenService:Create(blur, TweenInfo.new(0.4), {Size = 6}):Play()

	local baseFov = camera.FieldOfView
	TweenService:Create(camera, TweenInfo.new(0.4), {FieldOfView = baseFov + 20}):Play()

	local baseSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = baseSpeed * cfg.SPEED_MULT

	local startTime = os.clock()
	while os.clock() - startTime < cfg.DURATION and active do
		if not character.Parent or humanoid.Health <= 0 then break end
		local t = os.clock() - startTime
		spawnGhost(character, t)
		if cfg.SCREEN_TINT then
			cc.TintColor = Color3.new(1, 1, 1):Lerp(getColor(t, 0), 0.35)
		end
		task.wait(cfg.GHOST_RATE)
	end

	if humanoid and humanoid.Parent then humanoid.WalkSpeed = baseSpeed end
	TweenService:Create(camera, TweenInfo.new(0.4), {FieldOfView = baseFov}):Play()
	TweenService:Create(blur, TweenInfo.new(0.4), {Size = 0}):Play()
	TweenService:Create(cc, TweenInfo.new(0.4), {
		Saturation = 0, TintColor = Color3.new(1, 1, 1), Contrast = 0,
	}):Play()
	Debris:AddItem(blur, 0.5)
	Debris:AddItem(cc, 0.5)

	active = false
	onCooldown = true
	for i = cfg.COOLDOWN, 1, -1 do
		status.Text = "Recharge : " .. i .. "s"
		task.wait(1)
	end
	onCooldown = false
	status.Text = "Prêt"
end

----------------------------------------------------------------
-- SCAN : joueurs proches en rouge + pseudo
----------------------------------------------------------------
local function clearScan()
	for _, o in ipairs(scanObjects) do
		if o and o.Parent then o:Destroy() end
	end
	table.clear(scanObjects)
end

local function startScan()
	if scanning or scanOnCooldown then return end
	local character = player.Character
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	scanning = true
	local marks = {}

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			local head = plr.Character:FindFirstChild("Head")
			if root and head and (root.Position - myRoot.Position).Magnitude <= cfg.SCAN_RADIUS then
				local hl = Instance.new("Highlight")
				hl.FillColor = Color3.fromRGB(255, 0, 0)
				hl.OutlineColor = Color3.fromRGB(255, 80, 80)
				hl.FillTransparency = 0.45
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.Adornee = plr.Character
				hl.Parent = plr.Character
				table.insert(scanObjects, hl)

				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromOffset(180, 40)
				bb.StudsOffset = Vector3.new(0, 3, 0)
				bb.AlwaysOnTop = true
				bb.Adornee = head
				bb.Parent = head
				table.insert(scanObjects, bb)

				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.fromScale(1, 1)
				lbl.BackgroundTransparency = 1
				lbl.TextColor3 = Color3.fromRGB(255, 40, 40)
				lbl.TextStrokeTransparency = 0
				lbl.Font = Enum.Font.GothamBold
				lbl.TextSize = 16
				lbl.Text = plr.Name
				lbl.Parent = bb

				table.insert(marks, {plr = plr, root = root, label = lbl})
			end
		end
	end

	status.Text = (#marks == 0) and "Scan : personne à proximité" or ("SCAN : " .. #marks .. " cible(s)")

	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = Color3.fromRGB(255, 120, 120)
	cc.Contrast = 0.25
	cc.Parent = Lighting
	TweenService:Create(cc, TweenInfo.new(0.8), {TintColor = Color3.new(1, 1, 1), Contrast = 0}):Play()
	Debris:AddItem(cc, 1)

	local startTime = os.clock()
	while os.clock() - startTime < cfg.SCAN_DURATION and scanning do
		for _, m in ipairs(marks) do
			if m.root and m.root.Parent and myRoot.Parent then
				local d = math.floor((m.root.Position - myRoot.Position).Magnitude)
				m.label.Text = m.plr.Name .. " [" .. d .. "m]"
			end
		end
		task.wait(0.1)
	end

	clearScan()
	scanning = false
	scanOnCooldown = true
	task.wait(cfg.SCAN_COOLDOWN)
	scanOnCooldown = false
	if not active and not onCooldown then status.Text = "Prêt" end
end

----------------------------------------------------------------
-- INPUTS
----------------------------------------------------------------
table.insert(connections, UIS.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

	-- Changement de touche
	if waitingFor then
		if input.KeyCode ~= Enum.KeyCode.Escape then
			keys[waitingFor] = input.KeyCode
		end
		waitingButton.Text = keys[waitingFor].Name
		waitingFor, waitingButton = nil, nil
		return
	end

	-- Touche menu : marche même si le panel a le focus (sauf si on tape dans un champ)
	if input.KeyCode == keys.menu then
		if not UIS:GetFocusedTextBox() then
			frame.Visible = not frame.Visible
		end
		return
	end

	if gameProcessed then return end

	if input.KeyCode == keys.activate then
		task.spawn(startSandevistan)
	elseif input.KeyCode == keys.scan then
		task.spawn(startScan)
	end
end))

_G.SandevistanCleanup = function()
	active = false
	scanning = false
	for _, c in ipairs(connections) do c:Disconnect() end
	clearScan()
	if gui then gui:Destroy() end
end
